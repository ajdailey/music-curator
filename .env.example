# Copy to .env and fill in. The .env file is gitignored and must never be committed.
# Values already set in the real environment always win over this file.

# Required.
MUSIC_CURATOR_PLEX_URL=https://192.168.1.10:32400
MUSIC_CURATOR_PLEX_TOKEN=

# Optional.
# Music library name as it appears in Plex.
MUSIC_CURATOR_PLEX_LIBRARY=Music
# A Plex server on a private address usually presents a self-signed certificate.
# Defaults to false for https URLs, true otherwise. Set explicitly to be sure.
MUSIC_CURATOR_PLEX_VERIFY_SSL=false
# Root Plex reports for media paths. Matches the plex output root in settings.yaml.
MUSIC_CURATOR_PLEX_MEDIA_ROOT=/music_portable

# --- Optional: Last.fm enrichment (OFF by default) ---------------------------
# Only used by 'music-playlists lastfm enrich', which fills songs that have no
# listener count in Plex metadata. Never runs as part of generate, report, or
# plex sync. Free key: https://www.last.fm/api/account/create
# MUSIC_CURATOR_LASTFM_API_KEY=
# MUSIC_CURATOR_LASTFM_RATE_LIMIT=5
